################################
# WarehousePG gpinitsystem config
# Ansible template - 자동 생성
# 참고: https://www.enterprisedb.com/docs/warehousepg/latest/install_guide/init_whpg/
################################

# Coordinator 호스트명
COORDINATOR_HOSTNAME={{ coordinator_host }}

# Coordinator 포트
COORDINATOR_PORT={{ whpg_coordinator_port }}

# Coordinator 데이터 상위 디렉토리 (gpinitsystem 이 그 아래 {{ whpg_seg_prefix }}-1 을 만든다 → coordinator_data_dir)
COORDINATOR_DIRECTORY={{ coordinator_data_dir | dirname }}

# Array 이름
ARRAY_NAME="{{ whpg_array_name }}"

# 세그먼트 데이터 디렉토리 접두어
SEG_PREFIX={{ whpg_seg_prefix }}

# Primary 세그먼트 포트 시작 번호
PORT_BASE={{ whpg_port_base }}

# Primary 세그먼트 데이터 디렉토리 목록 (호스트당)
declare -a DATA_DIRECTORY=({% for dir in primary_data_dirs %}{{ dir }} {% endfor %})

# Mirror 는 여기서 만들지 않음 (MIRROR_* 미지정)
# → gpinitsystem 후 gpaddmirrors -i 로 whpg_mirror_group_size(4)대 단위 spread 배치, 2 / 3대는 한 그룹 (roles/whpg_init/tasks/mirrors.yml)

# 기본 데이터베이스 인코딩
ENCODING={{ whpg_encoding }}

# 로케일 (빈 문자열이면 OS 기본값 사용)
# LOCALE={{ whpg_locale }}

# 초기 생성 데이터베이스 이름
DATABASE_NAME={{ whpg_database }}

# Trusted Shell (ssh 권장)
TRUSTED_SHELL={{ whpg_trusted_shell }}

# 세그먼트 호스트 목록 파일
MACHINE_LIST_FILE={{ whpg_hostfile_segments }}

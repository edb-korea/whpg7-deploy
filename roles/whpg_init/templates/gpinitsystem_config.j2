################################
# WarehousePG gpinitsystem config
# Ansible template - 자동 생성
# 참고: https://www.enterprisedb.com/docs/warehousepg/latest/install_guide/init_whpg/
################################

# Coordinator 호스트명
COORDINATOR_HOSTNAME={{ coordinator_host }}

# Coordinator 포트
COORDINATOR_PORT=5432

# Coordinator 데이터 디렉토리
COORDINATOR_DATA_DIRECTORY={{ coordinator_data_dir }}

# Array 이름
ARRAY_NAME="WarehousePG Data Warehouse"

# 세그먼트 데이터 디렉토리 접두어
SEG_PREFIX=gpseg

# Primary 세그먼트 포트 시작 번호
PORT_BASE=6000

# Primary 세그먼트 데이터 디렉토리 목록 (호스트당)
declare -a DATA_DIRECTORY=({% for dir in primary_data_dirs %}{{ dir }} {% endfor %})

# Mirror 세그먼트 포트 시작 번호
MIRROR_PORT_BASE=7000

# Mirror 세그먼트 데이터 디렉토리 목록 (호스트당)
declare -a MIRROR_DATA_DIRECTORY=({% for dir in mirror_data_dirs %}{{ dir }} {% endfor %})

# 기본 데이터베이스 인코딩
ENCODING={{ whpg_encoding }}

# 로케일 (빈 문자열이면 OS 기본값 사용)
# LOCALE={{ whpg_locale }}

# 초기 생성 데이터베이스 이름
DATABASE_NAME=gpadmin

# Trusted Shell (ssh 권장)
TRUSTED_SHELL=ssh

# WAL 동기화 방식 (net 권장)
MACHINE_LIST_FILE={{ gpadmin_home }}/seg_hosts

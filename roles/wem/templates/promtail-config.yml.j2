server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://{{ hostvars[groups['standby_coordinator'][0]]['ansible_host'] }}:{{ loki_port }}/loki/api/v1/push

scrape_configs:
  # WarehousePG CSV 로그
  - job_name: warehousepg
    static_configs:
      - targets:
          - localhost
        labels:
          job: warehousepg
          host: {{ inventory_hostname }}
          __path__: /data/coordinator/gpseg-1/log/*.csv

  # WarehousePG 일반 로그
  - job_name: warehousepg_log
    static_configs:
      - targets:
          - localhost
        labels:
          job: warehousepg_log
          host: {{ inventory_hostname }}
          __path__: /data/primary/gpseg*/log/*.csv

  # 시스템 메시지
  - job_name: syslog
    static_configs:
      - targets:
          - localhost
        labels:
          job: syslog
          host: {{ inventory_hostname }}
          __path__: /var/log/messages

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'warehousepg'
    static_configs:
      - targets:
{% for host in groups['whpg_cluster'] %}
          - '{{ hostvars[host]['ansible_host'] }}:9187'
{% endfor %}

  - job_name: 'node'
    static_configs:
      - targets:
{% for host in groups['whpg_cluster'] %}
          - '{{ hostvars[host]['ansible_host'] }}:9100'
{% endfor %}

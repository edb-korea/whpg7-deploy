[Unit]
Description=PostgreSQL/WHPG Prometheus Exporter
After=network.target

[Service]
User={{ gpadmin_user }}
Group={{ gpadmin_group }}
Type=simple
Environment="DATA_SOURCE_NAME=postgresql://gpadmin@localhost:5432/gpadmin?sslmode=disable"
ExecStart=/opt/postgres_exporter/postgres_exporter \
  --web.listen-address=0.0.0.0:9187 \
  --log.level=info
Restart=on-failure

[Install]
WantedBy=multi-user.target

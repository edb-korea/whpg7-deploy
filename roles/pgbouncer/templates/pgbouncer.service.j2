[Unit]
Description=pgBouncer Connection Pooler
After=network.target

[Service]
User={{ gpadmin_user }}
Group={{ gpadmin_group }}
Type=forking
PIDFile={{ pgbouncer_run_dir }}/pgbouncer.pid
ExecStartPre=/bin/mkdir -p {{ pgbouncer_run_dir }} {{ pgbouncer_log_dir }}
ExecStartPre=/bin/chown {{ gpadmin_user }}:{{ gpadmin_group }} {{ pgbouncer_run_dir }} {{ pgbouncer_log_dir }}
ExecStart={{ pgbouncer_bin }} -d {{ pgbouncer_conf_file }}
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target

#!/bin/bash
# WarehousePG Coordinator 헬스체크 스크립트
source {{ whpg_install_dir }}/greenplum_path.sh
export COORDINATOR_DATA_DIRECTORY={{ coordinator_data_dir }}

psql -h {{ ha_healthcheck_host }} -p {{ whpg_coordinator_port }} -U {{ gpadmin_user }} -d {{ whpg_database }} -c "SELECT 1" -q -t 2>/dev/null | grep -q 1
exit $?

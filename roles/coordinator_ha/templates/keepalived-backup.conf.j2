! keepalived config - WarehousePG Standby Coordinator (BACKUP)

global_defs {
   router_id WHPG_STANDBY
}

vrrp_script chk_whpg {
    script "/opt/whpg_ha/whpg_healthcheck.sh"
    interval 5
    weight -20
    fall 2
    rise 2
}

vrrp_instance WHPG_VIP {
    state BACKUP
    interface {{ coordinator_vip_interface }}
    virtual_router_id 51
    priority 90
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ coordinator_vip }}
    }
    track_script {
        chk_whpg
    }
    notify_master "/opt/whpg_ha/whpg_promote.sh MASTER"
    notify_fault  "/opt/whpg_ha/whpg_demote.sh FAULT"
}

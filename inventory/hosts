# WarehousePG Cluster Inventory
# 호스트명 및 IP를 환경에 맞게 수정하세요
# 호스트 이름은 각 서버의 실제 hostname(`hostname` 명령 결과)과 같아야 한다.
#   다르면 gpinitsystem(primary)과 gpaddmirrors(mirror)가 gp_segment_configuration.hostname 에
#   서로 다른 이름을 기록해, PXF 등 hostname 기준 도구가 같은 서버를 두 대로 인식한다 (Phase 3 에서 확인 후 중단)

[coordinator]
whpg-cdw ansible_host=10.0.15.112

[standby_coordinator]
whpg-scdw ansible_host=10.0.8.209

# segment 호스트: 2 / 3대로 시작하면 4대까지 먼저 증설하고, 그 다음부터 4대(whpg_mirror_group_size) 단위로 증설한다.
# 처음 설치(gpinitsystem) 시 적힌 순서대로 mirror 그룹이 된다.
# 증설 시 현재 클러스터에 없는 호스트가 새 호스트가 된다 (위치 무관, 그룹 순서 = 기존 클러스터 순서 + 새 호스트 순서)
[segments]
whpg-sdw1 ansible_host=10.0.3.219
whpg-sdw2 ansible_host=10.0.14.73
whpg-sdw3 ansible_host=10.0.6.109  ansible_user=ec2-user
whpg-sdw4 ansible_host=10.0.14.22  ansible_user=ec2-user

[whpg_cluster:children]
coordinator
standby_coordinator
segments

[wem_node:children]
standby_coordinator

[pgbouncer_node:children]
coordinator
